%%{init: {'theme': 'base', 'themeVariables': { 'primaryColor': '#f5f0e8', 'primaryTextColor': '#2c1810', 'primaryBorderColor': '#8b6914', 'lineColor': '#8b6914', 'secondaryColor': '#f5f0e8', 'tertiaryColor': '#f5f0e8', 'fontFamily': 'Cinzel, serif', 'fontSize': '14px' }}}%%
graph LR
    START["🌿 Vines on the South Wall<br><i>Something is growing</i>"]

    subgraph TOWN["Graywall — Investigation Paths"]
        CASTLE["🏰 The Castle<br><i>lights, shadows, overgrown</i>"]
        MARKET["🏪 Bloody Market<br><i>Korrath is ranting</i>"]
        TAVERN["🍺 Tavern in Calabas<br><i>Dresh gossips</i>"]
        SARKUR["🧪 Sar Kuraath<br><i>Rixit's apothecary</i>"]
        WALL["🧱 South Wall<br><i>examine vines directly</i>"]
        LABYRINTH["⛏️ The Labyrinth<br><i>old Dhakaani tunnels</i>"]
    end

    subgraph NPCS["NPC Encounters"]
        VAELK["🎭 Vaelk<br><i>goblin changeling con artist</i>"]
        DRAVEN["👤 'Lord Draven'<br><i>answers the door</i>"]
        ALDRICE["👤 'Sister Aldrice'<br><i>Calabas clergy</i>"]
        KORRGA["👤 'Korrga'<br><i>Bloodstone docks</i>"]
        KORRATH["🌳 Korrath<br><i>warforged druid</i>"]
        THESSKA["🐍 Thesska Mirren<br><i>medusa noble</i>"]
        DRESH["💬 Dresh<br><i>ex-servant, gossip</i>"]
        RIXIT["🍵 Rixit<br><i>goblin herbalist</i>"]
        SERA["⚔️ Sera Tain<br><i>ex-paladin grifter</i>"]
        VERDEMIS["🌹 Lady Verdemis<br><i>'travelling botanist'</i>"]
    end

    subgraph CLUES["Clues & Evidence"]
        CRATES["📦 Matching crate markings<br><i>castle ↔ Thesska's cellar</i>"]
        MAP["🗺️ Rixit's Map<br><i>pins radiating SSW</i>"]
        TORVIK["💀 Torvik's Trail<br><i>missing 3 months</i>"]
        CREEPERS["🌱 Cazhaak creepers<br><i>unaffected — why?</i>"]
        NECROTIC["☠️ Necrotic trace<br><i>Herbalism DC 14</i>"]
        FORCED["⚡ 'Forced, not natural'<br><i>Nature DC 12</i>"]
    end

    WOOD["🌲 The Watching Wood<br><i>all roads lead here</i>"]
    GARDEN["🧛 Verdemis's Garden<br><i>the source</i>"]

    START --> CASTLE & MARKET & TAVERN & SARKUR & WALL & LABYRINTH

    CASTLE --> DRAVEN
    DRAVEN -->|"sneak past / push"| VAELK
    VAELK -.->|"same person"| DRAVEN
    VAELK -.->|"same person"| ALDRICE
    VAELK -.->|"same person"| KORRGA
    VAELK -->|"smuggling supplier"| THESSKA
    VAELK --> CRATES
    VAELK -->|"watches from tower<br><i>won't share yet</i>"| WOOD

    MARKET --> KORRATH
    MARKET -.->|"crowd gossip<br><i>after rose scene</i>"| SARKUR
    MARKET -.->|"crowd gossip<br><i>'Schwester Aldrice segnet...'</i>"| ALDRICE
    LABYRINTH -->|"warforged footprints<br><i>druid marks on walls</i>"| KORRATH
    KORRATH --> FORCED
    KORRATH -->|"points south"| WOOD

    TAVERN --> DRESH
    DRESH -->|"gossips about"| THESSKA
    THESSKA --> CRATES
    THESSKA --> CREEPERS
    CREEPERS --> NECROTIC

    SARKUR --> RIXIT
    RIXIT --> MAP
    RIXIT --> TORVIK
    MAP -->|"SSW vector"| WOOD
    TORVIK -->|"body in vines"| WOOD

    WALL --> FORCED
    WALL --> NECROTIC
    FORCED --> WOOD
    NECROTIC --> WOOD

    KORRATH <-.->|"secret meetings<br><i>she milks his knowledge</i>"| THESSKA

    SERA -.->|"detects fake"| ALDRICE
    KORRGA -.->|"moves crates"| CRATES
    KORRGA -.->|"works for<br><i>Vaelk keeps tabs</i>"| THESSKA
    RIXIT -.->|"thinks he's guilty<br><i>poisoned the well · post-it</i>"| KORRATH
    RIXIT -.->|"distrusts her<br><i>'something isn't right'</i>"| ALDRICE
    RIXIT -.->|"post-it"| VAELK

    VERDEMIS -.->|"customer of"| VAELK
    VERDEMIS -.->|"tracks him<br><i>points kids at him</i>"| KORRATH
    VERDEMIS -.->|"'helps' with plants<br><i>keeps her away from truth</i>"| THESSKA
    VERDEMIS -.->|"appears mid-phase<br><i>helpful, recurring</i>"| WOOD
    WOOD --> GARDEN

    style START fill:#f2c6c6,stroke:#8b2500,color:#2c1810
    style CASTLE fill:#f2c6c6,stroke:#8b2500,color:#2c1810
    style MARKET fill:#f2c6c6,stroke:#8b2500,color:#2c1810
